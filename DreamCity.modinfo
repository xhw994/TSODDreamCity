<?xml version="1.0" encoding="utf-8"?>
<Mod id="3b138c5a-bb00-42ce-9ae2-2186fbd5595b" version="1">
  <Properties>
    <Name>LOC_TSOD_DREAM_CITY_MOD_TITLE</Name>
    <Teaser>LOC_TSOD_DREAM_CITY_MOD_TEASER</Teaser>
    <Description>LOC_TSOD_DREAM_CITY_MOD_DESCRIPTION</Description>
    <Authors>Brus Gwyn Fuchkyo</Authors>
    <CompatibleVersions>2.0</CompatibleVersions>
  </Properties>

  <Dependencies>
    <Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="Expansion: Gathering Storm" />
  </Dependencies>

  <ActionCriteria>
    <Criteria id="Expansion2">
      <GameCoreInUse>Expansion2</GameCoreInUse>
    </Criteria>
    <Criteria id="CivitasCityStates">
      <ModInUse>7d0b57ba-6a5c-4de0-ac10-e1e464ac82f6</ModInUse>
    </Criteria>
  </ActionCriteria>

  <FrontEndActions>
    <!-- 散装 .dds 必须 ImportFiles 才进得了虚拟文件系统；只写在 <Files> 里
         是文件清单，不等于游戏能按 IconTextureAtlases.Filename 找到它。 -->
    <ImportFiles id="DreamCity_FE_ImportIcons">
      <Properties><LoadOrder>50</LoadOrder></Properties>
      <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_22.dds</File>
      <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_30.dds</File>
      <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_32.dds</File>
      <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_36.dds</File>
      <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_44.dds</File>
      <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_45.dds</File>
      <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_48.dds</File>
      <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_50.dds</File>
      <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_64.dds</File>
      <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_80.dds</File>
      <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_128.dds</File>
      <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_200.dds</File>
      <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_256.dds</File>
    </ImportFiles>
    <UpdateDatabase id="DreamCity_FE_Database">
      <Properties><LoadOrder>100</LoadOrder></Properties>
      <File>Data/DreamCity_Picker.sql</File>
      <File>Data/DreamCity_Config.sql</File>
    </UpdateDatabase>
    <UpdateIcons id="DreamCity_FE_Icons">
      <Properties><LoadOrder>100</LoadOrder></Properties>
      <File>Data/DreamCity_Icons.xml</File>
    </UpdateIcons>
    <UpdateColors id="DreamCity_FE_Colors">
      <Properties><LoadOrder>100</LoadOrder></Properties>
      <File>Data/DreamCity_Colors.sql</File>
    </UpdateColors>
    <UpdateText id="DreamCity_FE_Text">
      <Properties><LoadOrder>100</LoadOrder></Properties>
      <File>Text/DreamCity_Text.sql</File>
    </UpdateText>
  </FrontEndActions>

  <InGameActions>
    <ImportFiles id="DreamCity_IG_ImportIcons">
      <Properties><LoadOrder>50</LoadOrder></Properties>
      <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_22.dds</File>
      <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_30.dds</File>
      <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_32.dds</File>
      <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_36.dds</File>
      <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_44.dds</File>
      <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_45.dds</File>
      <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_48.dds</File>
      <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_50.dds</File>
      <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_64.dds</File>
      <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_80.dds</File>
      <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_128.dds</File>
      <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_200.dds</File>
      <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_256.dds</File>
    </ImportFiles>
    <!-- 类别定义必须排在城邦骨架之前：城邦领袖的 InheritFrom 指向类别领袖。 -->
    <UpdateDatabase id="DreamCity_IG_CityStateCategory">
      <Properties><LoadOrder>90</LoadOrder></Properties>
      <Criteria>Expansion2</Criteria>
      <File>Data/DreamCity_CityStateCategory.sql</File>
    </UpdateDatabase>
    <UpdateDatabase id="DreamCity_IG_Civilization">
      <Properties><LoadOrder>100</LoadOrder></Properties>
      <Criteria>Expansion2</Criteria>
      <File>Data/DreamCity_Civilizations.sql</File>
    </UpdateDatabase>
    <!-- 修正必须排在城邦骨架之后：TraitModifiers 的外键指向上面建的 trait。 -->
    <UpdateDatabase id="DreamCity_IG_Modifiers">
      <Properties><LoadOrder>200</LoadOrder></Properties>
      <Criteria>Expansion2</Criteria>
      <File>Data/DreamCity_Modifiers.sql</File>
    </UpdateDatabase>
    <UpdateIcons id="DreamCity_IG_Icons">
      <Properties><LoadOrder>100</LoadOrder></Properties>
      <Criteria>Expansion2</Criteria>
      <File>Data/DreamCity_Icons.xml</File>
    </UpdateIcons>
    <UpdateColors id="DreamCity_IG_Colors">
      <Properties><LoadOrder>100</LoadOrder></Properties>
      <Criteria>Expansion2</Criteria>
      <File>Data/DreamCity_Colors.sql</File>
    </UpdateColors>
    <UpdateText id="DreamCity_IG_Text">
      <Properties><LoadOrder>100</LoadOrder></Properties>
      <Criteria>Expansion2</Criteria>
      <File>Text/DreamCity_Text.sql</File>
    </UpdateText>
    <!-- 官方 CityStates.lua 把六个类别硬编码了，新类别落到 else 会 DataError。
         按社区约定：ReplaceUIScript 配一个同 LoadOrder 的 ImportFiles，
         这样后来的 mod 能 include 本文件接力，而不是把我们顶掉。 -->
    <ImportFiles id="DreamCity_IG_ImportUI">
      <Properties><LoadOrder>100000</LoadOrder></Properties>
      <Criteria>Expansion2</Criteria>
      <File>UI/CityStates_TSODDreamCity.lua</File>
    </ImportFiles>
    <ReplaceUIScript id="DreamCity_IG_CityStatesPanel">
      <Properties>
        <LoadOrder>100000</LoadOrder>
        <LuaContext>CityStates</LuaContext>
        <LuaReplace>UI/CityStates_TSODDreamCity.lua</LuaReplace>
      </Properties>
      <Criteria>Expansion2</Criteria>
    </ReplaceUIScript>
    <!-- 装了 CIVITAS City-States 时，往它的 CSE_ClassTypes 插一行，
         它的文明百科页就认得娱乐类别了。表不存在时整个 action 不加载。 -->
    <UpdateDatabase id="DreamCity_IG_CivitasCompat">
      <Properties><LoadOrder>100</LoadOrder></Properties>
      <Criteria>Expansion2</Criteria>
      <Criteria>CivitasCityStates</Criteria>
      <File>Data/DreamCity_Compat_CIVITAS.sql</File>
    </UpdateDatabase>
  </InGameActions>

  <LocalizedText>
    <Text id="LOC_TSOD_DREAM_CITY_MOD_TITLE">
      <en_US>[The Sword of Dawn (TSOD)] Dream City</en_US>
      <zh_Hans_CN>《黎明之剑》梦境之城</zh_Hans_CN>
    </Text>
    <Text id="LOC_TSOD_DREAM_CITY_MOD_TEASER">
      <en_US>An entertainment city-state watched over by the High Narrator, from the web novel The Sword of Dawn.</en_US>
      <zh_Hans_CN>来自网络小说《黎明之剑》、由上层叙事者看顾的娱乐城邦。</zh_Hans_CN>
    </Text>
    <Text id="LOC_TSOD_DREAM_CITY_MOD_DESCRIPTION">
      <en_US>Adds Dream City, an entertainment city-state from the online novel "The Sword of Dawn".[NEWLINE][NEWLINE]Requires the Gathering Storm ruleset.</en_US>
      <zh_Hans_CN>添加了来自网络小说《黎明之剑》的娱乐城邦「梦境之城」。[NEWLINE][NEWLINE]需要《风云变幻》规则集。</zh_Hans_CN>
    </Text>
  </LocalizedText>

  <Files>
    <File>Data/DreamCity_Civilizations.sql</File>
    <File>Data/DreamCity_Modifiers.sql</File>
    <File>Data/DreamCity_Colors.sql</File>
    <File>Data/DreamCity_Config.sql</File>
    <File>Data/DreamCity_Picker.sql</File>
    <File>Data/DreamCity_Icons.xml</File>
    <File>Text/DreamCity_Text.sql</File>
    <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_22.dds</File>
    <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_30.dds</File>
    <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_32.dds</File>
    <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_36.dds</File>
    <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_44.dds</File>
    <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_45.dds</File>
    <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_48.dds</File>
    <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_50.dds</File>
    <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_64.dds</File>
    <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_80.dds</File>
    <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_128.dds</File>
    <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_200.dds</File>
    <File>Textures/ICON_CIVILIZATION_TSOD_DREAM_CITY_256.dds</File>
    <File>UI/CityStates_TSODDreamCity.lua</File>
    <File>Data/DreamCity_CityStateCategory.sql</File>
    <File>Data/DreamCity_Compat_CIVITAS.sql</File>
  </Files>
</Mod>
